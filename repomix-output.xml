    public function test_manager_assigns_tellers_to_a_queue_lane(): void
    {
        QueueSystemSetting::current();
        $manager = User::factory()->manager()->create();
        $assigned = User::factory()->teller('شباك 1')->create(['name' => 'موظف الترشيح']);
