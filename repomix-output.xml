                                </label>
                            </div>
                            <p v-if="fieldErrors.college" class="mt-2 text-sm text-red-600">{{ fieldErrors.college }}</p>
                        </div>

                        <div>
                            <label class="mb-2 flex items-center gap-2 text-sm font-semibold text-slate-700">
                                <FileText class="h-4 w-4" />
